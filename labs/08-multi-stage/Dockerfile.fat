# Single-stage (larger / more than needed) — for comparison only.
# TypeScript, @types/*, source, and the compiled app all stay in the final image.
# Intentionally runs as root so you can contrast with USER node on the slim image.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json server.ts ./
RUN npm run build
EXPOSE 3000
CMD ["node", "dist/server.js"]
